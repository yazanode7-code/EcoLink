<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoLink</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcoLink.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        string? currentRole = null;
        if (User.Identity?.IsAuthenticated == true)
        {
            if (User.IsInRole(AppRoles.Admin)) currentRole = "Admin";
            else if (User.IsInRole(AppRoles.BranchEmployee)) currentRole = "Branch Employee";
            else if (User.IsInRole(AppRoles.Factory)) currentRole = "Factory";
            else if (User.IsInRole(AppRoles.Driver)) currentRole = "Driver";
        }
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-success" asp-controller="Account" asp-action="Login">EcoLink</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto">
                            @* روابط الشاشات بتنضاف هون حسب الدور *@
                        </ul>

                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success">@currentRole</span>
                            <span class="text-muted small">@User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Logout</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EcoLink
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>